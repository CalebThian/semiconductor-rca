{
  "train_dataset": "case1",
  "data": {
    "csv": "data/raw/semiconductor/case1.csv",
    "train_csv": "",
    "wafer_col": "LOT_ID,WAFER_ID",
    "label_col": "Symbol Define",
    "abnormal_value": "Abnormal",
    "exclude": [],
    "dropna": "row",
    "drop_col_na_frac": 0.5
  },
  "mtngc": {
    "task": "task2b",
    "lookback": 3,
    "hidden_dim": 64,
    "lambda_sparse": 0.1,
    "max_epochs": 100,
    "patience": 20,
    "n_blocks": 10,
    "mode": "stability",
    "n_seed": 20,
    "subsample": 0.8,
    "stability_edge_k": 2,
    "seed": 0,
    "graph_dir": "results"
  },
  "edges": {
    "out": "datasets/{train_dataset}_edges.csv",
    "edge_k": 0,
    "min_confidence": 0.0,
    "normalize": true,
    "transpose": false,
    "precision": 6
  },
  "colleague": {
    "cwd": "../fd_analysis/gnn-tam-main",
    "script": "run_pipeline.py",
    "config": "pipeline_config.yaml",
    "python": "",
    "group_col": "",
    "use_config": false,
    "output_csv": "experiment_results/checklist/checklist_{train_dataset}_{group_col}.csv"
  },
  "analysis": {
    "script": "scripts/run_pipeline.py",
    "config_out": "config/{train_dataset}_auto.json",
    "sensor_col": "Sensor",
    "priority_col": "Priority",
    "prefix": "results/{train_dataset}_pipeline",
    "brief": true,
    "show_welch": false,
    "n_perm": 300,
    "n_boot": 200,
    "add_statistical": true,
    "expansion": {
      "enabled": true,
      "max_hop": 2,
      "min_effect": null
    },
    "graph": {
      "edge_k": 2,
      "min_concentration": 0.0,
      "max_hop": 3
    },
    "rules": {
      "enabled": true,
      "test_frac": 0.4,
      "n_random": 200,
      "min_gain": 0.02,
      "gain_metric": "F1",
      "extend": false
    },
    "true_roots": []
  },
  "report": {
    "script": "scripts/make_html_report.py",
    "out": "results/{train_dataset}_report.html",
    "enabled": true
  }
}